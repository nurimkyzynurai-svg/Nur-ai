# Copy this file to ".env" and put your real key after the = sign.
# Get a key at https://console.anthropic.com/settings/keys
# The .env file is in .gitignore, so your key is never uploaded to GitHub.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port for the Viply backend server (optional)
PORT=8787

# Set to true to try the app with sample answers and no API key (optional).
# Set to needs-review to see what happens when a script never reaches the passing score.
MOCK_AI=false

# ---------- Market Intel ----------
# Password for the "Market Intel" admin tab (make up a long random one).
ADMIN_TOKEN=
# Emails that see the Market Intel tab in the dashboard (comma-separated).
VITE_ADMIN_EMAILS=you@example.com
# Max web searches per daily niche brief and per weekly founder report ($10 per 1,000 searches).
MARKET_BRIEF_MAX_SEARCHES=5
FOUNDER_REPORT_MAX_SEARCHES=10
# Max scheduled niche briefs per day (cost cap). On-demand briefs still run when a client generates content.
MARKET_INTEL_MAX_NICHES_PER_DAY=10
# "on" = research daily briefs for active niches and the weekly founder report automatically.
# "off" (default) = briefs are made on demand when a client generates content; the founder report and
# brief refreshes run only when you click "Refresh now" / "Run now" in the Market Intel admin tab.
MARKET_INTEL_SCHEDULER=off

# ---------- Contact & feedback ----------
# Public email shown in the landing page footer for partnerships and support.
# Leave empty to hide the email — visitors then see only the contact form.
VITE_CONTACT_EMAIL=
# Set to true when the server runs behind a reverse proxy / hosting platform, so the
# feedback rate limit (5 messages per 10 minutes per IP) sees the real visitor IP.
TRUST_PROXY=false
